# Copy to .env and adjust if needed. Read by docker-compose.yml.
POSTGRES_USER=csgrundlagen
POSTGRES_PASSWORD=csgrundlagen
POSTGRES_DB=csgrundlagen
POSTGRES_PORT=5432
API_PORT=8080
WEB_PORT=3000
# Public origin of the web app (used in password reset emails).
APP_BASE_URL=http://localhost:3000
# Where Go snippets run (default: the official Go Playground); "off" disables it.
# GO_PLAYGROUND_URL=off

# Connection string for the Go API when run locally (npm run api:dev),
# and for external tools like DBeaver or psql.
DATABASE_URL=postgres://csgrundlagen:csgrundlagen@localhost:5432/csgrundlagen
