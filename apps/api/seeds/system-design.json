    {
      "type": "design",
      "prompt": "Design rate limiting for a public API",
      "tags": [
        "System Design"
      ],
      "difficulty": "medium",
      "explanation": "Every request hits the gateway, which increments a per-key counter in Redis (a fixed or sliding window, or a token bucket) and answers 429 once the limit is reached. Only allowed requests are forwarded to the API instances, and no route goes around the gateway.",
      "materials": [
        "ratelimit"
      ],
      "design": {
        "requirements": [
          {
            "id": "limit",
            "text": "Each API key gets at most 100 requests per minute"
          },
          {
            "id": "shared",
            "text": "The limit holds across all API servers, not per server"
          },
          {
            "id": "fast",
            "text": "Rejected requests are turned away before they reach the application"
          }
        ],
        "rules": [
          {
            "id": "limiter",
            "kind": "path",
            "text": "Requests pass a rate limiter or API gateway first",
            "explanation": "Checking limits at the edge turns abusive traffic away before it costs anything.",
            "requirement": "fast",
            "materialKey": "ratelimit",
            "from": [
              "client"
            ],
            "via": [
              "rate-limiter",
              "api-gateway"
            ],
            "to": [
              "service"
            ]
          },
          {
            "id": "counters",
            "kind": "edge",
            "text": "The limiter keeps its counters in a shared cache",
            "explanation": "Counters in each server's memory would let a client get 100 requests per server. A shared store like Redis gives one limit everywhere.",
            "requirement": "shared",
            "from": [
              "rate-limiter",
              "api-gateway"
            ],
            "to": [
              "cache"
            ]
          },
          {
            "id": "no-bypass",
            "kind": "no-edge",
            "text": "Clients can't reach the service without the limiter",
            "explanation": "A side door around the limiter makes it pointless.",
            "requirement": "limit",
            "from": [
              "client"
            ],
            "to": [
              "service"
            ]
          },
          {
            "id": "instances",
            "kind": "has",
            "text": "Several service instances",
            "explanation": "The limiter protects a scaled-out service, which is why counters must be shared.",
            "requirement": "shared",
            "of": [
              "service"
            ],
            "min": 2
          }
        ],
        "reference": {
          "nodes": [
            {
              "id": "c",
              "kind": "client",
              "label": "API client"
            },
            {
              "id": "gw",
              "kind": "api-gateway",
              "label": "gateway + limiter"
            },
            {
              "id": "k",
              "kind": "cache",
              "label": "Redis counters"
            },
            {
              "id": "s1",
              "kind": "service",
              "label": "api-1"
            },
            {
              "id": "s2",
              "kind": "service",
              "label": "api-2"
            },
            {
              "id": "db",
              "kind": "sql"
            }
          ],
          "edges": [
            {
