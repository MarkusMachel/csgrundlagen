    {
      "type": "design",
      "prompt": "Design a notification service that sends email, SMS and push messages",
      "tags": [
        "System Design"
      ],
      "difficulty": "medium",
      "explanation": "Producers publish a notification event and move on. A pool of sender workers consumes the queue, checks preferences and calls the email, SMS or push provider, retrying on failure. Scheduled reminders enter through the same queue.",
      "materials": [
        "competing",
        "queue-leveling"
      ],
      "design": {
        "requirements": [
          {
            "id": "decouple",
            "text": "Many internal services trigger notifications without waiting for them to be sent"
          },
          {
            "id": "spikes",
            "text": "A burst of a million notifications must not overload the senders"
          },
          {
            "id": "prefs",
            "text": "Users' notification preferences are respected"
          }
        ],
        "rules": [
          {
            "id": "queue",
            "kind": "path",
            "text": "Notifications go through a queue to sender workers",
            "explanation": "The queue takes the burst. Workers drain it at a pace the email and SMS providers accept.",
            "requirement": "spikes",
            "materialKey": "queue-leveling",
            "from": [
              "service"
            ],
            "via": [
              "queue"
            ],
            "to": [
              "worker"
            ]
          },
          {
            "id": "no-direct",
            "kind": "no-edge",
            "text": "Services don't call the senders directly",
            "explanation": "Direct calls tie every service to provider outages and slowness.",
            "requirement": "decouple",
            "from": [
              "service"
            ],
            "to": [
              "worker"
            ]
          },
          {
            "id": "workers",
            "kind": "has",
            "text": "Several sender workers",
            "explanation": "Competing consumers share the load and keep going if one crashes.",
            "requirement": "spikes",
            "materialKey": "competing",
            "of": [
              "worker"
            ],
            "min": 2
          },
          {
            "id": "prefs",
            "kind": "edge",
            "text": "Workers check user preferences before sending",
            "explanation": "Someone who turned off SMS must not get one, even for a queued message.",
            "requirement": "prefs",
            "from": [
              "worker"
            ],
            "to": [
              "sql",
              "nosql",
              "cache"
            ]
          },
          {
            "id": "scheduled",
            "kind": "edge",
            "text": "A scheduler queues timed notifications",
            "explanation": "Reminders and digests are sent later. A scheduler drops them into the same pipeline.",
            "optional": true,
            "from": [
              "scheduler"
            ],
            "to": [
              "queue"
            ]
          }
