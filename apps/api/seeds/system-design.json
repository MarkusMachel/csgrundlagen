            ]
          },
          {
            "id": "geo",
            "kind": "edge",
            "text": "Current locations live in an in-memory geo index",
            "explanation": "Locations change every few seconds and are queried by area. A cache with geo queries (like Redis GEO) fits. A relational table doesn't.",
            "requirement": "nearby",
            "materialKey": "geohash",
            "from": [
              "service"
            ],
            "to": [
              "cache"
            ]
          },
          {
            "id": "trips",
            "kind": "edge",
            "text": "Trips are stored in a database",
