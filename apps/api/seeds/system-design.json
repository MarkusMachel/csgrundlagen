    {
      "type": "design",
      "prompt": "Design the home timeline of a Twitter-like social network",
      "tags": [
        "System Design"
      ],
      "difficulty": "hard",
      "explanation": "Writes store the post and enqueue a fan-out job. Workers push the post ID into each follower's cached timeline (fan-out on write). Reads come straight from the cache, with replicas serving misses. Celebrities with millions of followers are usually merged in at read time instead (a hybrid approach).",
      "materials": [
        "cache-aside",
        "lb",
        "queue-leveling",
        "replication"
      ],
      "design": {
        "requirements": [
          {
            "id": "post",
            "text": "Users publish short posts"
          },
          {
            "id": "read",
            "text": "The home timeline opens in under 200 ms; reads far outnumber posts"
          },
          {
            "id": "fanout",
            "text": "Followers see a new post within a few seconds"
          },
          {
            "id": "scale",
            "text": "It scales to millions of users and survives server failures"
          }
        ],
        "rules": [
          {
            "id": "front",
            "kind": "path",
            "text": "Requests go through a load balancer",
            "explanation": "Spreads load and routes around failed instances.",
            "requirement": "scale",
            "materialKey": "lb",
            "from": [
              "client"
            ],
            "via": [
              "load-balancer",
              "api-gateway"
            ],
            "to": [
              "service"
            ]
          },
          {
            "id": "instances",
            "kind": "has",
            "text": "Several service instances",
            "explanation": "One instance can't carry millions of users, nor survive its own failure.",
            "requirement": "scale",
            "of": [
              "service"
            ],
            "min": 2
          },
          {
            "id": "posts",
            "kind": "edge",
            "text": "Posts are stored in a database",
            "explanation": "Posts are the source of truth that timelines are built from.",
            "requirement": "post",
            "from": [
              "service"
            ],
            "to": [
              "sql",
              "nosql"
            ]
          },
          {
            "id": "timeline-cache",
            "kind": "edge",
            "text": "Timelines are read from a cache",
            "explanation": "Building a timeline on every read means querying everyone you follow. Precomputed timelines in memory make reads cheap.",
            "requirement": "read",
            "materialKey": "cache-aside",
            "from": [
              "service"
            ],
            "to": [
              "cache"
            ]
          },
          {
            "id": "fanout-queue",
            "kind": "path",
            "text": "New posts fan out through a queue to workers",
            "explanation": "Writing a post into thousands of follower timelines is slow. A queue does it in the background, so posting stays fast.",
            "requirement": "fanout",
            "materialKey": "queue-leveling",
            "from": [
              "service"
            ],
            "via": [
              "queue"
            ],
            "to": [
              "worker"
            ]
          },
          {
            "id": "worker-cache",
            "kind": "edge",
            "text": "Fan-out workers write into the timeline cache",
            "explanation": "The workers push each new post into the cached timelines of its author's followers.",
            "requirement": "fanout",
            "from": [
              "worker"
            ],
            "to": [
              "cache"
            ]
          },
          {
            "id": "replicas",
            "kind": "has",
            "text": "Read replicas take database reads",
            "explanation": "Replicas spread read load and give a copy to fail over to.",
            "requirement": "scale",
            "optional": true,
            "materialKey": "replication",
            "of": [
              "replica"
            ]
          }
        ],
