              "label": "Browser"
            },
            {
              "id": "rl",
              "kind": "rate-limiter"
            },
            {
              "id": "lb",
              "kind": "load-balancer"
            },
            {
              "id": "s1",
              "kind": "service",
              "label": "shortener-1"
            },
            {
              "id": "s2",
              "kind": "service",
              "label": "shortener-2"
            },
            {
              "id": "k",
              "kind": "cache",
              "label": "Redis"
            },
            {
              "id": "db",
              "kind": "nosql",
              "label": "links"
            }
          ],
          "edges": [
            {
              "from": "c",
              "to": "rl"
            },
            {
              "from": "rl",
              "to": "lb"
            },
