      "title": "The System Design Primer",
      "url": "https://github.com/donnemartin/system-design-primer",
      "author": "Donne Martin",
      "description": "A free, community-maintained guide to designing large-scale systems."
    },
    {
      "key": "lb",
      "type": "article",
      "title": "Load balancing (computing)",
      "url": "https://en.wikipedia.org/wiki/Load_balancing_(computing)",
      "author": "Wikipedia",
      "description": "How load balancers spread requests across servers and route around failed ones."
    },
    {
      "key": "cache-aside",
      "type": "article",
      "title": "Cache-Aside pattern",
      "url": "https://learn.microsoft.com/en-us/azure/architecture/patterns/cache-aside",
      "author": "Microsoft Learn",
      "description": "Load data into a cache on demand to speed up repeated reads."
    },
    {
      "key": "queue-leveling",
      "type": "article",
      "title": "Queue-Based Load Leveling pattern",
      "url": "https://learn.microsoft.com/en-us/azure/architecture/patterns/queue-based-load-leveling",
      "author": "Microsoft Learn",
      "description": "A queue between producers and workers absorbs spikes in load."
    },
    {
      "key": "competing",
      "type": "article",
      "title": "Competing Consumers pattern",
      "url": "https://learn.microsoft.com/en-us/azure/architecture/patterns/competing-consumers",
      "author": "Microsoft Learn",
      "description": "Several workers read from one queue to share the work and survive failures."
    },
    {
      "key": "static",
      "type": "article",
      "title": "Static Content Hosting pattern",
      "url": "https://learn.microsoft.com/en-us/azure/architecture/patterns/static-content-hosting",
      "author": "Microsoft Learn",
      "description": "Serve files from storage and a CDN instead of from the application servers."
    },
    {
      "key": "valet",
      "type": "article",
      "title": "Valet Key pattern",
      "url": "https://learn.microsoft.com/en-us/azure/architecture/patterns/valet-key",
      "author": "Microsoft Learn",
      "description": "Let clients upload straight to storage with a short-lived, limited token."
    },
    {
      "key": "ratelimit",
      "type": "article",
      "title": "Rate Limiting pattern",
      "url": "https://learn.microsoft.com/en-us/azure/architecture/patterns/rate-limiting-pattern",
      "author": "Microsoft Learn",
      "description": "Throttle requests so one caller can't overload a service."
    },
    {
      "key": "cdn",
