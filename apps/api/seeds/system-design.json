    {
      "type": "design",
      "prompt": "Design a one-to-one chat app like WhatsApp",
      "tags": [
        "System Design"
      ],
      "difficulty": "hard",
      "explanation": "Phones hold WebSocket connections to gateways behind a load balancer. The chat service stores each message, finds the recipient's gateway in the presence cache and pushes it there. If the recipient is offline, a notification job is queued for the push worker, and the app syncs from the message store when it reconnects.",
      "materials": [
        "lb",
        "queue-leveling",
        "websocket"
      ],
      "design": {
        "requirements": [
          {
            "id": "realtime",
            "text": "Messages arrive in real time while both people are online"
          },
          {
            "id": "offline",
            "text": "People who are offline get their messages and a push notification later"
          },
          {
            "id": "history",
            "text": "Conversation history is kept"
          }
        ],
        "rules": [
          {
            "id": "ws",
            "kind": "path",
            "text": "Clients keep a WebSocket connection to a gateway",
            "explanation": "Polling for new messages is slow and wasteful. A persistent connection lets the server push messages instantly.",
            "requirement": "realtime",
            "materialKey": "websocket",
            "from": [
              "client"
            ],
            "via": [
              "websocket"
            ],
            "to": [
              "service"
            ]
          },
          {
            "id": "ws-lb",
            "kind": "path",
            "text": "Connections are spread over gateways by a load balancer",
            "explanation": "One gateway can only hold so many open connections.",
            "requirement": "realtime",
            "materialKey": "lb",
            "from": [
              "client"
            ],
            "via": [
              "load-balancer"
            ],
            "to": [
              "websocket"
            ]
          },
          {
            "id": "presence",
            "kind": "edge",
            "text": "The service looks up who is online in a cache",
            "explanation": "To deliver a message, the service must know which gateway holds the recipient's connection. That lookup happens constantly and belongs in memory.",
            "requirement": "realtime",
            "from": [
              "service"
            ],
            "to": [
              "cache"
            ]
          },
          {
            "id": "history",
            "kind": "edge",
            "text": "Messages are stored in a database",
            "explanation": "Messages must be stored before delivery, so nothing is lost and history can be loaded.",
            "requirement": "history",
            "from": [
              "service"
            ],
            "to": [
              "sql",
              "nosql"
            ]
          },
          {
            "id": "push",
            "kind": "path",
            "text": "Push notifications are sent by a worker from a queue",
            "explanation": "Calling the push provider is slow and can fail. A queue with retrying workers keeps chat responsive.",
            "requirement": "offline",
            "materialKey": "queue-leveling",
            "from": [
              "service"
            ],
            "via": [
              "queue"
            ],
            "to": [
              "worker"
            ]
          }
        ],
        "reference": {
          "nodes": [
            {
              "id": "c",
              "kind": "client",
              "label": "Phone"
            },
            {
              "id": "lb",
              "kind": "load-balancer"
            },
            {
              "id": "g1",
              "kind": "websocket",
              "label": "gateway-1"
            },
            {
              "id": "g2",
              "kind": "websocket",
              "label": "gateway-2"
            },
            {
              "id": "s",
              "kind": "service",
              "label": "chat"
            },
            {
              "id": "k",
              "kind": "cache",
              "label": "presence"
            },
