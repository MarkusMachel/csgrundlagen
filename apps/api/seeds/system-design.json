    {
      "type": "design",
      "prompt": "Design a URL shortener like bit.ly",
      "tags": [
        "System Design"
      ],
      "difficulty": "easy",
      "explanation": "A load balancer in front of two or more stateless shortener instances keeps the site up. Each redirect first checks Redis (cache-aside) and falls back to a key-value store holding code → URL. Clients only ever talk to the service. A rate limiter in front stops spam bots from creating millions of links.",
      "materials": [
        "cache-aside",
        "lb",
        "primer",
        "ratelimit"
      ],
      "design": {
        "requirements": [
          {
            "id": "create",
            "text": "Users create a short link for a long URL"
          },
          {
            "id": "redirect",
            "text": "Opening a short link redirects in a few milliseconds; reads outnumber writes 100 to 1"
          },
          {
            "id": "uptime",
            "text": "The service keeps working when one server fails"
          }
        ],
        "rules": [
          {
            "id": "front",
            "kind": "path",
            "text": "Requests reach the service through a load balancer",
            "explanation": "A load balancer spreads traffic and stops sending requests to a server that has failed.",
            "requirement": "uptime",
            "materialKey": "lb",
            "from": [
              "client"
            ],
            "via": [
              "load-balancer",
              "api-gateway"
            ],
            "to": [
              "service"
            ]
          },
          {
            "id": "instances",
            "kind": "has",
            "text": "At least two service instances",
            "explanation": "With one instance, a crash or a deploy takes the whole site down.",
            "requirement": "uptime",
            "materialKey": "lb",
            "of": [
              "service"
            ],
            "min": 2
          },
          {
            "id": "store",
            "kind": "edge",
            "text": "Links are stored in a database",
            "explanation": "The mapping from short code to URL must survive restarts.",
            "requirement": "create",
            "from": [
              "service"
            ],
            "to": [
              "sql",
              "nosql"
            ]
          },
          {
            "id": "cache",
            "kind": "edge",
            "text": "The service checks a cache before the database",
            "explanation": "Popular links are read constantly. Serving them from memory keeps redirects fast and takes load off the database.",
            "requirement": "redirect",
            "materialKey": "cache-aside",
            "from": [
              "service"
            ],
            "to": [
              "cache"
            ]
          },
          {
            "id": "no-direct-db",
            "kind": "no-edge",
            "text": "Clients never talk to the database directly",
            "explanation": "Only the service should reach the database: it validates input and keeps credentials private.",
            "materialKey": "primer",
            "from": [
              "client"
            ],
            "to": [
              "sql",
              "nosql",
              "cache"
            ]
          },
          {
            "id": "abuse",
            "kind": "path",
            "text": "A rate limiter stops one user from creating millions of links",
            "explanation": "Shorteners attract spam. Limiting link creation per user or IP protects storage and reputation.",
            "requirement": "create",
            "optional": true,
            "materialKey": "ratelimit",
            "from": [
              "client"
            ],
            "via": [
              "rate-limiter",
              "api-gateway"
            ],
            "to": [
              "service"
            ]
          }
        ],
        "reference": {
          "nodes": [
