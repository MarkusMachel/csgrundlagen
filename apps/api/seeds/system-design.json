    {
      "type": "design",
      "prompt": "Design photo uploads and viewing for an Instagram-like app",
      "tags": [
        "System Design"
      ],
      "difficulty": "medium",
      "explanation": "The API asks for a signed URL, the app uploads the photo straight to object storage, and the API records metadata in SQL. A resize job goes on a queue, and thumbnail workers write the results back to storage. Viewers load every image through a CDN in front of the storage.",
      "materials": [
        "cdn",
        "lb",
        "queue-leveling",
        "static",
        "valet"
      ],
      "design": {
        "requirements": [
          {
            "id": "upload",
            "text": "Users upload photos of up to 20 MB"
          },
          {
            "id": "view",
            "text": "Photos load quickly for users all over the world"
          },
          {
            "id": "thumbs",
            "text": "Thumbnails are generated without making uploads slower"
          }
        ],
        "rules": [
          {
            "id": "front",
            "kind": "path",
            "text": "API requests go through a load balancer",
            "explanation": "Spreads traffic across instances and routes around failures.",
            "materialKey": "lb",
            "from": [
              "client"
            ],
            "via": [
              "load-balancer",
              "api-gateway"
            ],
            "to": [
              "service"
            ]
          },
          {
            "id": "blob",
            "kind": "has",
            "text": "Photos live in object storage",
            "explanation": "Object storage (like S3) is cheap, durable and built for large files. Databases are not.",
            "requirement": "upload",
            "materialKey": "static",
            "of": [
              "object-storage"
            ]
          },
          {
            "id": "cdn",
            "kind": "path",
            "text": "Photos are served through a CDN",
            "explanation": "A CDN caches photos close to users, so they load fast everywhere and storage isn't hit for every view.",
            "requirement": "view",
            "materialKey": "cdn",
            "from": [
              "client"
            ],
            "via": [
              "cdn"
            ],
            "to": [
              "object-storage"
            ]
          },
          {
            "id": "meta",
            "kind": "edge",
            "text": "Photo metadata is kept in a database",
            "explanation": "Captions, owners and links to the stored files are small, structured data that you query.",
            "requirement": "upload",
            "from": [
              "service"
            ],
            "to": [
              "sql",
              "nosql"
            ]
          },
          {
            "id": "async",
            "kind": "path",
            "text": "Thumbnails are made by a worker fed from a queue",
            "explanation": "Resizing takes time. Queuing the job lets the upload return at once, and workers catch up during spikes.",
            "requirement": "thumbs",
            "materialKey": "queue-leveling",
            "from": [
              "service"
            ],
            "via": [
              "queue"
            ],
            "to": [
              "worker"
            ]
          },
          {
            "id": "worker-out",
            "kind": "edge",
            "text": "The worker saves thumbnails to object storage",
            "explanation": "Thumbnails are files too, served the same way as the originals.",
            "requirement": "thumbs",
            "from": [
              "worker"
            ],
            "to": [
              "object-storage"
            ]
          },
          {
            "id": "direct-upload",
            "kind": "edge",
            "text": "Clients upload straight to storage with a signed URL",
            "explanation": "With a short-lived signed URL, large uploads skip your servers entirely (valet key).",
            "requirement": "upload",
            "optional": true,
            "materialKey": "valet",
            "from": [
              "client"
            ],
            "to": [
              "object-storage"
            ]
          }
        ],
        "reference": {
